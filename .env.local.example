NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CRON_SECRET=um_segredo_longo_e_aleatorio

# --- Sugestões por IA (somente servidor; nunca NEXT_PUBLIC_*) ---
# Padrão: Google Gemini (grátis) — https://aistudio.google.com/apikey
AI_SUGGESTIONS_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Modelos grátis comuns: gemini-2.0-flash | gemini-1.5-flash | gemini-2.5-flash
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800
AI_RATE_LIMIT_PER_USER_HOUR=40

# Alternativa OpenAI/Groq (opcional):
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Jev / TypeSafe (somente servidor; nunca NEXT_PUBLIC_) ---
# Julgamentos calibrados (classificar, pontuar, verificar, ranquear).
# Sem a chave, o código degrada para heurística local.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# --- Rotação de IAs com fallback automático (docs/IA_ROTACAO_GUIA.md) ---
# Ordem padrão: Gemini primeiro (grátis); IA_PREFERIDA=openrouter inverte.
# Sem nenhuma chave, tudo degrada para manual — nunca trava a tela.
# OPENROUTER_API_KEY=
# OPENROUTER_MODELOS_TEXTO=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,inclusionai/ling-3.0-flash-fin:free
# OPENROUTER_MODELOS_VISAO=inclusionai/ling-3.0-flash-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# GEMINI_API_KEYS=chave1,chave2
# IA_PREFERIDA=gemini
